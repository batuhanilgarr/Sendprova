# Public URL of this app. Asset links inside test emails are built from it,
# so inboxes must be able to reach it (use a tunnel or real domain for Gmail tests).
APP_URL="http://localhost:3000"

# Postgres (docker compose)
DATABASE_URL="postgresql://mailing:mailing@localhost:5433/mailing?schema=public"

# Redis (docker compose)
REDIS_URL="redis://localhost:6379"

# Asset storage: "local" (./.data/assets, served by the app) or "s3" (R2/S3/MinIO)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="mailing-assets"
S3_PUBLIC_URL=""

# Default SMTP transport for test sends (Mailpit in docker compose)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mailing Test <test@mailing.local>"

# Better Auth
BETTER_AUTH_SECRET="change-me-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
# The first user who signs up with this email becomes admin and inherits the pre-auth "default" workspace
ADMIN_EMAIL=""
