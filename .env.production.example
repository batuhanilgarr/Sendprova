# Copy to .env.production (docker compose) or paste into your host's environment settings.

# Public URL of the deployment. Share links, open pixels and auth cookies depend on it.
APP_URL="https://app.sendprova.com"
BETTER_AUTH_URL="https://app.sendprova.com"
BETTER_AUTH_SECRET=""          # openssl rand -base64 32
ADMIN_EMAIL="you@example.com"  # first sign-up with this email becomes admin

# Postgres. On Railway/Render/Fly use the connection string they give you.
# With docker-compose.prod.yml leave DATABASE_URL unset and set POSTGRES_PASSWORD instead.
DATABASE_URL=""
POSTGRES_PASSWORD=""

# Images and snapshots. Use R2 (or any S3) in production so inboxes can load them.
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="sendprova-assets"
S3_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Optional default SMTP for notification emails before a workspace adds its own sender.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sendprova <no-reply@sendprova.com>"
