generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A workspace belongs to one user and holds their projects, senders, groups and credits.
model Workspace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  ownerId   String?   @unique
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Cached balance; every change also writes a CreditLedger row.
  credits   Int       @default(0)
  // ---- agency branding shown on review pages and the client portal ----
  brandName      String?
  brandLogoUrl   String?
  brandColor     String?
  hidePoweredBy  Boolean   @default(false)
  reviewDomain   String?
  createdAt DateTime  @default(now())
  projects  Project[]
  senders   SenderProfile[]
  groups    RecipientGroup[]
  ledger    CreditLedger[]
  clients   Client[]
}

/// An agency's customer. Projects, brand kit and reviewers hang off it.
model Client {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  contactName  String?
  contactEmail String?
  color        String?
  // ---- brand kit ----
  logoUrl              String?
  colors               String[] // allowed hex colors
  fonts                String[] // allowed font family names
  footerText           String?  // required legal / footer sentence
  physicalAddress      String?  // required postal address (CAN-SPAM, KVKK)
  unsubscribeToken     String?  // placeholder or URL fragment that must be present
  utmTemplate          String?  // e.g. utm_source=newsletter&utm_medium=email
  allowedDomains       String[] // links must point at these hosts
  /// Token for the client's portal (all their projects in one link).
  portalToken  String?   @unique
  createdAt    DateTime  @default(now())
  projects     Project[]

  @@index([workspaceId])
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

/// 1 credit = 1 recipient in one test send. Positive = top-up, negative = usage.
model CreditLedger {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  delta       Int
  reason      String
  testSendId  String?
  byUserId    String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ---- Better Auth ----------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  workspace     Workspace?

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// A mailing. Each save creates a new Version.
model Project {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status      ProjectStatus @default(DRAFT)
  /// Agreed number of revision rounds; a round is one "changes requested" decision.
  revisionLimit  Int       @default(2)
  reviewDeadline DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  versions    Version[]
  shareLinks  ShareLink[]

  @@index([workspaceId, updatedAt])
  @@index([clientId])
}

/// Public, read-only preview link. Always shows the project's latest version.
model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  views     Int       @default(0)
}

enum SourceKind {
  HTML
  MJML
}

model Version {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number     Int
  sourceKind SourceKind @default(HTML)
  /// Original source as uploaded (HTML or MJML), with relative asset paths intact.
  source     String
  /// Compiled + asset-rewritten HTML that is actually previewed and sent.
  html       String
  subject    String?
  /// Detected ESP placeholders such as {unsubscribelink} or *|FNAME|*.
  placeholders String[]
  /// Relative asset references that could not be matched to an uploaded file.
  missingAssets String[]
  htmlBytes  Int
  createdAt  DateTime   @default(now())
  assets     Asset[]
  testSends  TestSend[]
  checkRuns  CheckRun[]
  comments   Comment[]
  approvals  Approval[]
  snapshots  Snapshot[]
  diffs      VersionDiff[] @relation("DiffTarget")
  diffBases  VersionDiff[] @relation("DiffBase")

  @@unique([projectId, number])
}

/// Full-page screenshot of a version at one device width, stored as an asset.
model Snapshot {
  id        String   @id @default(cuid())
  versionId String
  version   Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  device    String
  url       String
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@unique([versionId, device])
}

/// Pixel diff between two versions' snapshots plus a text diff summary.
model VersionDiff {
  id            String   @id @default(cuid())
  versionId     String
  version       Version  @relation("DiffTarget", fields: [versionId], references: [id], onDelete: Cascade)
  baseVersionId String
  baseVersion   Version  @relation("DiffBase", fields: [baseVersionId], references: [id], onDelete: Cascade)
  device        String
  diffUrl       String
  changedRatio  Float
  width         Int
  height        Int
  createdAt     DateTime @default(now())

  @@unique([versionId, baseVersionId, device])
}

/// A comment pinned to a point on the preview of one version.
model Comment {
  id          String    @id @default(cuid())
  versionId   String
  version     Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("Thread")
  /// Fraction of the preview width/height (0..1) at pin time; null for replies.
  x           Float?
  y           Float?
  device      String?
  body        String
  authorName  String
  authorEmail String?
  /// Set when the author is a signed-in workspace member (agency side).
  byUserId    String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([versionId, createdAt])
}

enum Decision {
  APPROVED
  CHANGES_REQUESTED
}

model Approval {
  id            String   @id @default(cuid())
  versionId     String
  version       Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  decision      Decision
  note          String?
  reviewerName  String
  reviewerEmail String?
  createdAt     DateTime @default(now())

  @@index([versionId, createdAt])
}

/// Result of an on-demand check pass (links, images, alt text) for a version.
model CheckRun {
  id        String   @id @default(cuid())
  versionId String
  version   Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  result    Json
  createdAt DateTime @default(now())

  @@index([versionId, createdAt])
}

/// An uploaded file (image etc.) stored in object storage.
model Asset {
  id        String   @id @default(cuid())
  versionId String
  version   Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// Path relative to the uploaded HTML file, e.g. "images/index_01.png".
  path      String
  key       String
  url       String
  mime      String
  bytes     Int
  createdAt DateTime @default(now())

  @@index([versionId])
}

enum Transport {
  SMTP
  SES
  RESEND
}

model SenderProfile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  fromName    String
  fromEmail   String
  transport   Transport @default(SMTP)
  /// Transport config (host, port, user, pass / keys). Encrypted at rest later.
  config      Json
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  testSends   TestSend[]
}

model RecipientGroup {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  recipients  Recipient[]
  createdAt   DateTime    @default(now())
}

model Recipient {
  id      String         @id @default(cuid())
  groupId String
  group   RecipientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email   String
  name    String?
}

enum SendStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

model TestSend {
  id         String        @id @default(cuid())
  versionId  String
  version    Version       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     SenderProfile? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  subject    String
  status     SendStatus    @default(QUEUED)
  createdAt  DateTime      @default(now())
  deliveries Delivery[]
}

model Delivery {
  id         String     @id @default(cuid())
  testSendId String
  testSend   TestSend   @relation(fields: [testSendId], references: [id], onDelete: Cascade)
  email      String
  status     SendStatus @default(QUEUED)
  messageId  String?
  error      String?
  sentAt     DateTime?
}
